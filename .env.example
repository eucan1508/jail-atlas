# Public identity remains configurable. Fixtures and local canonical URLs use example.test.
BRAND_NAME="County Custody Information"
PRODUCTION_DOMAIN="https://example.test"
DEFAULT_LOCALE="en-US"

# Synthetic mode is allowed for local/test only. Production validation rejects it.
DATA_MODE="synthetic"
APP_ENV="development"
DATABASE_URL="postgresql://custody_app:custody_app@127.0.0.1:5432/custody_phase_one"

# Server-only protection and throttling settings. These examples are rejected in production;
# production requires separately supplied random values of at least 32 characters.
CURSOR_SIGNING_SECRET="replace-with-at-least-32-random-characters"
CORRECTION_FORM_HMAC_SECRET="replace-with-at-least-32-random-characters"
ROSTER_API_RATE_LIMIT="30"
ROSTER_API_RATE_WINDOW_SECONDS="60"

# An approved production source allowlist is intentionally absent in Phase 1.
SOURCE_HOST_ALLOWLIST=""

# Phase 1 ingestion is intentionally synthetic and fail-closed. These values cannot fetch or write.
INGEST_MODE="synthetic"
INGEST_NETWORK_ACCESS="disabled"
INGEST_DATABASE_WRITES="disabled"
ALLOW_LIVE_SOURCE_FETCHES="false"
SCOTT_COUNTY_LIVE_SOURCE_ENABLED="false"
